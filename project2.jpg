<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <linearGradient id="project2Gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#fd79a8;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#e65a88;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="600" height="400" fill="url(#project2Gradient)"/>
  
  <!-- Game grid -->
  <g opacity="0.2">
    <line x1="0" y1="80" x2="600" y2="80" stroke="#ffffff" stroke-width="2"/>
    <line x1="0" y1="160" x2="600" y2="160" stroke="#ffffff" stroke-width="2"/>
    <line x1="0" y1="240" x2="600" y2="240" stroke="#ffffff" stroke-width="2"/>
    <line x1="0" y1="320" x2="600" y2="320" stroke="#ffffff" stroke-width="2"/>
    <line x1="120" y1="0" x2="120" y2="400" stroke="#ffffff" stroke-width="2"/>
    <line x1="240" y1="0" x2="240" y2="400" stroke="#ffffff" stroke-width="2"/>
    <line x1="360" y1="0" x2="360" y2="400" stroke="#ffffff" stroke-width="2"/>
    <line x1="480" y1="0" x2="480" y2="400" stroke="#ffffff" stroke-width="2"/>
  </g>
  
  <!-- Towers -->
  <g>
    <!-- Tower 1 -->
    <rect x="100" y="140" width="40" height="60" fill="#ffffff"/>
    <rect x="95" y="130" width="50" height="15" fill="#ffffff"/>
    <circle cx="120" cy="125" r="8" fill="#6c5ce7"/>
    
    <!-- Tower 2 -->
    <rect x="350" y="200" width="40" height="60" fill="#ffffff"/>
    <rect x="345" y="190" width="50" height="15" fill="#ffffff"/>
    <circle cx="370" cy="185" r="8" fill="#6c5ce7"/>
    
    <!-- Tower 3 -->
    <rect x="220" y="260" width="40" height="60" fill="#ffffff"/>
    <rect x="215" y="250" width="50" height="15" fill="#ffffff"/>
    <circle cx="240" cy="245" r="8" fill="#6c5ce7"/>
  </g>
  
  <!-- Enemy path -->
  <path d="M 50,120 L 200,120 L 200,200 L 400,200 L 400,280 L 550,280" 
        fill="none" 
        stroke="rgba(255,255,255,0.3)" 
        stroke-width="20" 
        stroke-linecap="round"/>
  
  <!-- Enemies -->
  <circle cx="180" cy="120" r="15" fill="#2d2d2d">
    <animate attributeName="cx" from="50" to="550" dur="8s" repeatCount="indefinite"/>
  </circle>
  
  <circle cx="350" cy="200" r="15" fill="#2d2d2d">
    <animate attributeName="cx" from="50" to="550" dur="8s" begin="2s" repeatCount="indefinite"/>
  </circle>
  
  <!-- Title -->
  <text x="300" y="50" font-family="Poppins, sans-serif" font-size="36" font-weight="bold" fill="#ffffff" text-anchor="middle">Tower Defense</text>
  
  <!-- Gamepad icon -->
  <g transform="translate(470, 20)">
    <rect x="0" y="5" width="40" height="25" rx="5" fill="rgba(255,255,255,0.8)"/>
    <circle cx="10" cy="17" r="3" fill="#fd79a8"/>
    <circle cx="30" cy="17" r="3" fill="#6c5ce7"/>
  </g>
</svg>