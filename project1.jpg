<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <linearGradient id="project1Gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#6c5ce7;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#5849c7;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="600" height="400" fill="url(#project1Gradient)"/>
  
  <!-- Grid pattern -->
  <g opacity="0.1">
    <line x1="0" y1="100" x2="600" y2="100" stroke="#ffffff" stroke-width="1"/>
    <line x1="0" y1="200" x2="600" y2="200" stroke="#ffffff" stroke-width="1"/>
    <line x1="0" y1="300" x2="600" y2="300" stroke="#ffffff" stroke-width="1"/>
    <line x1="150" y1="0" x2="150" y2="400" stroke="#ffffff" stroke-width="1"/>
    <line x1="300" y1="0" x2="300" y2="400" stroke="#ffffff" stroke-width="1"/>
    <line x1="450" y1="0" x2="450" y2="400" stroke="#ffffff" stroke-width="1"/>
  </g>
  
  <!-- Wallet icon -->
  <rect x="200" y="120" width="200" height="140" rx="20" fill="rgba(255,255,255,0.9)"/>
  <rect x="200" y="120" width="200" height="40" rx="20" fill="#ffffff"/>
  <circle cx="350" cy="210" r="30" fill="none" stroke="#6c5ce7" stroke-width="6"/>
  <circle cx="350" cy="210" r="15" fill="#6c5ce7"/>
  
  <!-- Coins -->
  <circle cx="150" cy="280" r="30" fill="rgba(253, 121, 168, 0.8)"/>
  <text x="150" y="290" font-family="monospace" font-size="24" fill="#ffffff" text-anchor="middle" font-weight="bold">$</text>
  
  <circle cx="450" cy="300" r="25" fill="rgba(253, 121, 168, 0.6)"/>
  <text x="450" y="308" font-family="monospace" font-size="20" fill="#ffffff" text-anchor="middle" font-weight="bold">$</text>
  
  <!-- Title -->
  <text x="300" y="360" font-family="Poppins, sans-serif" font-size="36" font-weight="bold" fill="#ffffff" text-anchor="middle">BilleTico</text>
  
  <!-- Subtitle -->
  <text x="300" y="385" font-family="Roboto, sans-serif" font-size="16" fill="rgba(255,255,255,0.8)" text-anchor="middle">Virtual Wallet Application</text>
</svg>