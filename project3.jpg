<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <defs>
    <linearGradient id="project3Gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2d2d2d;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#3a3a3a;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="600" height="400" fill="url(#project3Gradient)"/>
  
  <!-- Browser window -->
  <rect x="80" y="60" width="440" height="280" rx="10" fill="rgba(108, 92, 231, 0.2)" stroke="#6c5ce7" stroke-width="2"/>
  
  <!-- Browser header -->
  <rect x="80" y="60" width="440" height="40" rx="10" fill="#6c5ce7"/>
  <circle cx="100" cy="80" r="6" fill="#ff5f56"/>
  <circle cx="120" cy="80" r="6" fill="#ffbd2e"/>
  <circle cx="140" cy="80" r="6" fill="#27c93f"/>
  
  <!-- URL bar -->
  <rect x="170" y="70" width="250" height="20" rx="10" fill="rgba(255,255,255,0.2)"/>
  <text x="180" y="84" font-family="monospace" font-size="12" fill="#ffffff">https://chrishuang.dev</text>
  
  <!-- Website content mockup -->
  <g transform="translate(100, 120)">
    <!-- Header -->
    <rect x="0" y="0" width="400" height="30" fill="rgba(108, 92, 231, 0.3)"/>
    <rect x="10" y="8" width="80" height="14" fill="#6c5ce7"/>
    <rect x="320" y="8" width="70" height="14" fill="#fd79a8"/>
    
    <!-- Hero section -->
    <rect x="0" y="40" width="180" height="80" fill="rgba(253, 121, 168, 0.2)"/>
    <rect x="10" y="50" width="120" height="12" fill="rgba(255,255,255,0.4)"/>
    <rect x="10" y="68" width="160" height="8" fill="rgba(255,255,255,0.3)"/>
    <rect x="10" y="80" width="140" height="8" fill="rgba(255,255,255,0.3)"/>
    <rect x="10" y="100" width="80" height="12" fill="#6c5ce7"/>
    
    <!-- Image placeholder -->
    <rect x="220" y="40" width="180" height="80" fill="rgba(108, 92, 231, 0.2)"/>
    <circle cx="310" cy="80" r="20" fill="rgba(255,255,255,0.3)"/>
    
    <!-- Content sections -->
    <rect x="0" y="130" width="120" height="80" fill="rgba(108, 92, 231, 0.15)"/>
    <rect x="10" y="140" width="80" height="8" fill="rgba(255,255,255,0.4)"/>
    <rect x="10" y="154" width="100" height="6" fill="rgba(255,255,255,0.2)"/>
    <rect x="10" y="164" width="100" height="6" fill="rgba(255,255,255,0.2)"/>
    
    <rect x="140" y="130" width="120" height="80" fill="rgba(253, 121, 168, 0.15)"/>
    <rect x="150" y="140" width="80" height="8" fill="rgba(255,255,255,0.4)"/>
    <rect x="150" y="154" width="100" height="6" fill="rgba(255,255,255,0.2)"/>
    <rect x="150" y="164" width="100" height="6" fill="rgba(255,255,255,0.2)"/>
    
    <rect x="280" y="130" width="120" height="80" fill="rgba(108, 92, 231, 0.15)"/>
    <rect x="290" y="140" width="80" height="8" fill="rgba(255,255,255,0.4)"/>
    <rect x="290" y="154" width="100" height="6" fill="rgba(255,255,255,0.2)"/>
    <rect x="290" y="164" width="100" height="6" fill="rgba(255,255,255,0.2)"/>
  </g>
  
  <!-- Code symbols -->
  <text x="550" y="100" font-family="monospace" font-size="48" fill="rgba(108, 92, 231, 0.3)" font-weight="bold">&lt;/&gt;</text>
  
  <!-- Title -->
  <text x="300" y="365" font-family="Poppins, sans-serif" font-size="28" font-weight="bold" fill="#6c5ce7" text-anchor="middle">Custom Web Development</text>
</svg>