<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="400" height="400">
  <defs>
    <linearGradient id="profileGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#6c5ce7;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#8b7bff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#fd79a8;stop-opacity:1" />
    </linearGradient>
    <pattern id="techPattern" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
      <circle cx="20" cy="20" r="1" fill="rgba(255,255,255,0.1)"/>
      <line x1="0" y1="20" x2="40" y2="20" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>
      <line x1="20" y1="0" x2="20" y2="40" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>
    </pattern>
  </defs>
  
  <!-- Background -->
  <rect width="400" height="400" fill="url(#profileGradient)"/>
  <rect width="400" height="400" fill="url(#techPattern)"/>
  
  <!-- Geometric shapes -->
  <circle cx="200" cy="150" r="80" fill="rgba(255,255,255,0.1)" stroke="#ffffff" stroke-width="3"/>
  
  <!-- Stylized person icon -->
  <circle cx="200" cy="135" r="35" fill="#ffffff"/>
  <path d="M 145,250 Q 145,190 200,190 Q 255,190 255,250 L 255,280 L 145,280 Z" fill="#ffffff"/>
  
  <!-- Code brackets -->
  <text x="80" y="120" font-family="Space Mono, monospace" font-size="80" fill="rgba(255,255,255,0.3)" font-weight="bold">&lt;</text>
  <text x="290" y="120" font-family="Space Mono, monospace" font-size="80" fill="rgba(255,255,255,0.3)" font-weight="bold">/&gt;</text>
  
  <!-- Name -->
  <text x="200" y="340" font-family="Poppins, sans-serif" font-size="32" font-weight="bold" fill="#ffffff" text-anchor="middle">CHRIS HUANG</text>
  
  <!-- Subtitle -->
  <text x="200" y="370" font-family="Roboto, sans-serif" font-size="16" fill="rgba(255,255,255,0.8)" text-anchor="middle">Software Engineer</text>
</svg>